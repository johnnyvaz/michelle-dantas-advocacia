{
  "mcpServers": {
    "supabase": {
      "type": "http",
      "url": "https://mcp.supabase.com/mcp?project_ref=lecvllupatsilfqizqcb&read_only=true&features=docs%2Caccount%2Cdatabase%2Cdebugging%2Cdevelopment%2Cfunctions%2Cbranching"
    },
    "netlify-mcp": {
      "command": "npx",
      "args": ["-y", "@netlify/mcp"]
    },
    "search-console": {
      "command": "npx",
      "args": ["-y", "mcp-server-gsc"],
      "env": {
        "GOOGLE_APPLICATION_CREDENTIALS": "/home/johnny/.config/gsc/service-account.json"
      }
    },
    "analytics-mcp": {
      "command": "pipx",
      "args": ["run", "analytics-mcp"],
      "env": {
        "GOOGLE_APPLICATION_CREDENTIALS": "/home/johnny/.config/gsc/service-account.json",
        "GOOGLE_PROJECT_ID": "${GOOGLE_PROJECT_ID}"
      }
    },
    "bing-webmaster": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/isiahw1/mcp-server-bing-webmaster",
        "--with",
        "mcp[cli]<2",
        "mcp-server-bing-webmaster"
      ],
      "env": {
        "BING_WEBMASTER_API_KEY": "${BING_WEBMASTER_API_KEY}"
      }
    },
    "dataforseo": {
      "command": "npx",
      "args": ["-y", "dataforseo-mcp-server@3.1.3"],
      "env": {
        "DATAFORSEO_USERNAME": "${DATAFORSEO_USERNAME}",
        "DATAFORSEO_PASSWORD": "${DATAFORSEO_PASSWORD}"
      }
    },
    "openseo-local": {
      "type": "http",
      "url": "http://localhost:3001/mcp"
    }
  }
}
